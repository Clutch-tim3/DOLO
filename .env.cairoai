# Deployed-only configuration for the `cairoai` project.
#
# The Firebase CLI loads `.env` AND `.env.<projectId>` at deploy time; app.py's
# load_dotenv only reads `.env` and `.env.local`. So anything that must be true
# in production and NOT locally belongs here.
#
# That distinction is not cosmetic: CLOUD_SQL_INSTANCE in `.env` made every
# local import try to open a Cloud SQL connection and fail without Application
# Default Credentials, which broke the test suite and the manifest generator.
#
# No secrets in this file — it is committed. The password is in Secret Manager
# and bound in main.py.

CLOUD_SQL_INSTANCE=cairoai:us-central1:cairoai-db
CLOUD_SQL_DB=cairoai
CLOUD_SQL_USER=cairoai_app

# --- OAuth, moved here from `gcloud run services update --update-env-vars` ---
#
# Those were set directly on the Cloud Run service, and `firebase deploy`
# rewrites the service config and drops them. That is how GOOGLE_OAUTH_CLIENT_ID
# vanished once already: the deploy reported success, and /api/providers/connect
# started returning 503 with nothing in the logs pointing at the cause.
#
# Set here instead, they are part of the deploy and cannot be wiped by it. This
# also matters now because gcloud is no longer installed on the dev machine, so
# there is no way to put them back after a deploy removes them.
#
# Neither is a secret. The client ID is published in every authorization URL the
# browser sees, and the base URL is the site itself. The client SECRET is in
# Secret Manager and bound in main.py.
GOOGLE_OAUTH_CLIENT_ID=327662856299-lkch66lf3tqiekqigdtsmi7o4ehq9rg9.apps.googleusercontent.com

# Used to build the OAuth redirect_uri. Without it that was derived from the
# Cloud Run origin (http://api-xxxx.run.app) and Google rejected the callback
# with redirect_uri_mismatch, because the registered URI is on the hosting
# domain. Must match a URI registered on the OAuth client exactly.
PUBLIC_BASE_URL=https://cairoai.web.app
