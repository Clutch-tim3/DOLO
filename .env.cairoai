# Deployed-only configuration for the `cairoai` project.
#
# The Firebase CLI loads `.env` AND `.env.<projectId>` at deploy time; app.py's
# load_dotenv only reads `.env` and `.env.local`. So anything that must be true
# in production and NOT locally belongs here.
#
# That distinction is not cosmetic: CLOUD_SQL_INSTANCE in `.env` made every
# local import try to open a Cloud SQL connection and fail without Application
# Default Credentials, which broke the test suite and the manifest generator.
#
# No secrets in this file — it is committed. The password is in Secret Manager
# and bound in main.py.

CLOUD_SQL_INSTANCE=cairoai:us-central1:cairoai-db
CLOUD_SQL_DB=cairoai
CLOUD_SQL_USER=cairoai_app
