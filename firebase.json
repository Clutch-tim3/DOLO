{
  "functions": {
    "source": ".",
    "runtime": "python312",
    "ignore": [
      ".git",
      "**/venv/**",
      "**/env/**",
      "firebase_public",
      "*.json.bak",
      "data/procurement.db",
      "**/data/archive/**",
      "**/data/splits/**",
      "**/data/uk_raw/**",
      "**/catboost_info/**",
      "**/__pycache__/**",
      "tests",
      ".pytest_cache",
      ".hypothesis",
      "node_modules",
      "test-functions",
      "scratch_scripts",

      "google-cloud-sdk",
      "gcloud.zip",
      "access_token.txt",
      "*.bak",
      "static/downloads",
      "**/*.tar.gz",
      "**/*.csv",

      ".env",
      ".env.local",

      "**/backup_pre_split_fix_*/**",
      "models/saved/archive/**"
    ]
  },
  "hosting": {
    "site": "cairoai",
    "public": "firebase_public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
