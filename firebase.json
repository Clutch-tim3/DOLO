{
  "functions": {
    "source": ".",
    "runtime": "python310"
  },
  "hosting": {
    "site": "cairoai",
    "public": "firebase_public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
